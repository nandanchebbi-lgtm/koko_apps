{
  "version": 2,
  "outputDirectory": "app-hub/dist",

  "routes": [
    {
      "src": "^/assets/(.*)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^/favicon.ico$",
      "dest": "/favicon.ico"
    },

    {
      "src": "^/meditation/assets/(.*)$",
      "dest": "/meditation-app/dist/assets/$1"
    },
    {
      "src": "^/music/assets/(.*)$",
      "dest": "/music-therapy-app/build/static/$1"
    },

    {
      "src": "^/meditation(/.*)?$",
      "dest": "/meditation-app/dist/index.html"
    },
    {
      "src": "^/music(/.*)?$",
      "dest": "/music-therapy-app/build/index.html"
    },

    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}