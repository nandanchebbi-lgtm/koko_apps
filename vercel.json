{
  "version": 2,

  "builds": [
    {
      "src": "app-hub/package.json",
      "use": "@vercel/static-build",
      "config": {
        "outputDirectory": "dist"
      }
    },
    {
      "src": "meditation-app/package.json",
      "use": "@vercel/static-build",
      "config": {
        "outputDirectory": "dist"
      }
    },
    {
      "src": "music-therapy-app/package.json",
      "use": "@vercel/static-build",
      "config": {
        "outputDirectory": "build"
      }
    }
  ],

  "routes": [
    { "src": "^/$", "dest": "/app-hub/dist/index.html" },
    { "src": "^/meditation(/.*)?$", "dest": "/meditation-app/dist/index.html" },
    { "src": "^/music(/.*)?$", "dest": "/music-therapy-app/build/index.html" }
  ]
}