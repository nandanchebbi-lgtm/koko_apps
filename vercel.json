{
  "version": 2,

  "builds": [
    {
      "src": "app-hub/dist/**",
      "use": "@vercel/static"
    },
    {
      "src": "meditation-app/dist/**",
      "use": "@vercel/static"
    },
    {
      "src": "music-therapy-app/build/**",
      "use": "@vercel/static"
    }
  ],

  "routes": [
    {
      "src": "^/$",
      "dest": "/app-hub/dist/index.html"
    },
    {
      "src": "^/meditation(/.*)?$",
      "dest": "/meditation-app/dist/index.html"
    },
    {
      "src": "^/music(/.*)?$",
      "dest": "/music-therapy-app/build/index.html"
    }
  ]
}