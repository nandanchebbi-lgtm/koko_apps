{
  "version": 2,
  "builds": [
    {
      "src": "app-hub/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "meditation-app/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "music-therapy-flow/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" }
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/app-hub/dist/index.html"
    },
    {
      "src": "^/meditation(/.*)?$",
      "dest": "/meditation-app/dist/index.html"
    },
    {
      "src": "^/music(/.*)?$",
      "dest": "/music-therapy-flow/build/index.html"
    }
  ]
}